# ---------------------------------------------------------------------------
# NeuralAccessPsyche (NRAM) — environment configuration example.
#
# Copy this file to `.env` and adjust values:
#   cp .env.example .env
#
# `docker compose` reads `.env` automatically for ${VAR} substitution.
# ---------------------------------------------------------------------------

# --- SGLang inference image -------------------------------------------------
# `latest` is a PLACEHOLDER for local development only. For any real or
# reproducible deployment, PIN the image to a validated sha256 digest, e.g.:
#
#   SGLANG_IMAGE=lmsysorg/sglang@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
#
# Pick the digest after confirming the launch flags in
# inference/sglang/entrypoint.sh against that exact image:
#   docker compose run --rm sglang python3 -m sglang.launch_server --help
SGLANG_IMAGE=lmsysorg/sglang:latest

# --- NRAM API ---------------------------------------------------------------
# Shared secret required by the nram-api TokenAuthMiddleware. Clients must
# send this as the bearer/API key. Change this for anything beyond local dev.
NRAM_API_KEY=dev-nram-key

# --- Hugging Face -----------------------------------------------------------
# Optional. Only needed if SGLang must pull a GATED tokenizer/config from the
# Hub. Leave empty if not required. Never commit a real token to git.
HF_TOKEN=

# Where Hugging Face caches tokenizers/configs INSIDE the sglang container.
# This is backed by the `hf-cache` named volume in compose.yaml so it
# persists across restarts. The MODEL WEIGHTS are NOT stored here.
HF_HOME=/root/.cache/huggingface

# ---------------------------------------------------------------------------
# LOCAL GGUF MODEL (do NOT configure a download path here)
# ---------------------------------------------------------------------------
# The model is a LOCAL file on the host, NOT downloaded by Docker:
#
#   E:\_MODELS\huggingface\hub\DeepSeek-R1-Distill-Qwen-7B-GGUF\DeepSeek-R1-Distill-Qwen-7B-Q4_K_M.gguf
#
# It is mounted READ-ONLY into the sglang container at /models via
# compose.yaml:
#
#   /mnt/e/_MODELS/huggingface/hub/DeepSeek-R1-Distill-Qwen-7B-GGUF:/models:ro
#
# (On Windows/WSL2 the E:\ drive maps to /mnt/e.) If you move the model,
# update the volume mount in compose.yaml — do not bake the model into an
# image and do not let SGLang re-download it.
# ---------------------------------------------------------------------------
